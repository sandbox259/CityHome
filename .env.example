# Copy this file to .env.local for local development.
# In production (Cloudflare Workers), set these as Worker secrets/vars instead
# (see README.md "Cloudflare Deployment" section) — never commit real values.

# --- Resend (transactional email) ---
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=hello@cityhomesbyaashiyaanaa.com

# --- Cloudflare Turnstile (form spam protection) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- WhatsApp click-to-chat (digits only, with country code, no +) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=911234567890

# --- Cloudflare R2 (property images) ---
# Public base URL for the R2 bucket (or a custom domain / resizing Worker in
# front of it). Falls back to an on-the-fly dev placeholder if left unset.
NEXT_PUBLIC_R2_IMAGE_BASE_URL=
